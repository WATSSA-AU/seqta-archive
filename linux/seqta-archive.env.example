# SEQTA Archive settings. Restart after editing: sudo systemctl restart seqta-archive

SCHOOL_NAME=Example Senior High School
SCHOOL_SHORT=ESHS
TIMEZONE=Australia/Perth

SEQTA_DATA_DIR=/srv/seqta-archive
SEQTA_STATE_DIR=/var/lib/seqta-archive

# The app listens here; put HTTPS (nginx, Caddy, Apache, IIS, Traefik...) in front of it.
HOST=127.0.0.1
PORT=8080
# URL_PREFIX=/seqta

# ---- Sign-in -------------------------------------------------------------
# local: built-in accounts.  sudo -u seqta-archive seqta-archive user add NAME --admin
AUTH_MODE=local
REQUIRE_TOTP=1
SESSION_HOURS=8
COOKIE_SECURE=1

# proxy: an authenticating reverse proxy (oauth2-proxy + Keycloak/Entra/...) sets X-Forwarded-*.
# AUTH_MODE=proxy
# TRUSTED_PROXIES=127.0.0.1,::1
# ACCESS_GROUPS=seqta-archive-users,seqta-archive-admin
# ADMIN_GROUPS=seqta-archive-admin
# OIDC_CLIENT_ID=seqta-archive
