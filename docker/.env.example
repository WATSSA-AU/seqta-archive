# ---- About your school -------------------------------------------------------
SCHOOL_NAME=Example Senior High School
SCHOOL_SHORT=ESHS
TIMEZONE=Australia/Perth

# ---- Sign-in --------------------------------------------------------------------
# local = built-in accounts (create them with: docker compose exec archive seqta-archive user add NAME --admin)
# proxy = an OIDC provider via compose.oidc.yaml
AUTH_MODE=local
REQUIRE_TOTP=1
SESSION_HOURS=8

# Keep 1 unless you're testing on http://localhost only.
COOKIE_SECURE=1

# ---- Network ----------------------------------------------------------------------
# Where the container listens on the host. 127.0.0.1 = this machine only (use the https profile
# for staff access). Set BIND=0.0.0.0 only behind your own HTTPS reverse proxy.
BIND=127.0.0.1
HOST_PORT=8080

# For the https profile (Caddy):
SITE_ADDRESS=archive.example.school
UPSTREAM=archive:8080
# With compose.oidc.yaml use:  UPSTREAM=oauth2-proxy:4180

# With the https profile, let the archive log real client addresses from Caddy:
# TRUSTED_PROXIES=127.0.0.1,::1,caddy

# Optional: serve under a sub-path, e.g. /seqta
URL_PREFIX=

# ---- OIDC (only with compose.oidc.yaml) -------------------------------------------
# OIDC_CLIENT_ID=seqta-archive
# OIDC_CLIENT_SECRET=
# OIDC_COOKIE_SECRET=   # generate: python3 -c "import secrets;print(secrets.token_urlsafe(32)[:32])"
